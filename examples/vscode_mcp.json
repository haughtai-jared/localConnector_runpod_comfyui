{
  "servers": {
    "runpod-comfyui": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "runpod_comfyui_mcp"],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUNPOD_API_KEY": "${input:runpod-api-key}",
        "RUNPOD_ENDPOINT_ID": "${input:runpod-endpoint-id}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "runpod-api-key",
      "description": "Runpod API key (https://www.runpod.io/console/user/settings)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "runpod-endpoint-id",
      "description": "Runpod serverless endpoint id (the part after /v2/)"
    }
  ]
}
