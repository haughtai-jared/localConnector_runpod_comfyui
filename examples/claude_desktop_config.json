{
  "mcpServers": {
    "runpod-comfyui": {
      "command": "/absolute/path/to/localConnector_runpod_comfyui/.venv/bin/python",
      "args": ["-m", "runpod_comfyui_mcp"],
      "cwd": "/absolute/path/to/localConnector_runpod_comfyui",
      "env": {
        "RUNPOD_API_KEY": "replace-with-your-runpod-api-key",
        "RUNPOD_ENDPOINT_ID": "replace-with-your-endpoint-id"
      }
    }
  }
}
