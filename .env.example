# ─────────────────────────────────────────────────────────────────────────────
# runpod-comfyui-mcp — copy this file to `.env` and fill in your own values.
#
#     cp .env.example .env
#
# `.env` is git-ignored. Real environment variables always win over this file,
# so a client that injects RUNPOD_API_KEY itself will override what is here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# From https://www.runpod.io/console/user/settings → API Keys.
# This is a secret: never commit it, never paste it into a screenshot or an issue.
RUNPOD_API_KEY=

# Your serverless endpoint id — the part of the endpoint URL after /v2/.
# e.g. https://api.runpod.ai/v2/abc123def456 → abc123def456
RUNPOD_ENDPOINT_ID=


# ── Optional: Runpod behaviour ───────────────────────────────────────────────
# API host. Change only when you proxy Runpod.
RUNPOD_BASE_URL=https://api.runpod.ai/v2

# Wall-clock budget for one render (seconds). Cold starts on a big model can take
# several minutes; 900 s covers most Krea2 jobs.
RUNPOD_JOB_TIMEOUT_S=900

# Seconds between status polls.
RUNPOD_POLL_INTERVAL_S=2


# ── Optional: local paths ────────────────────────────────────────────────────
# Where rendered images are written. Relative paths resolve from the CWD.
RUNPOD_OUTPUT_DIR=./output

# ComfyUI API-format workflow. Commented out = the bundled Krea2 Turbo template.
# WORKFLOW_PATH=./workflows/krea2_turbo_t2i.json


# ── Optional: MCP server ─────────────────────────────────────────────────────
# stdio (default), or streamable-http when Haught Studio connects over HTTP.
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=streamable-http.
MCP_HOST=127.0.0.1
MCP_PORT=8600

# Set when the HTTP server is reached through a tunnel or reverse proxy, so the
# URLs returned in tool results are actually usable by the caller.
# MCP_PUBLIC_BASE_URL=https://your-tunnel.example.com

# INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO
